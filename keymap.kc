// ~/.config/zed/keymap.kc — the whole keymap, in keycook form. Build: keycook build keymap.kc
//
// Nesting is `&&` on one Zed node; `>` headers are Zed's descendant operator; `key: action`;
// `prefix: { … }` is a chord family; keys sharing an action share a line; `a | b: X | Y` pairs.
// Lines marked `// ours` are the semantic layer; everything else is carried over from Zed's defaults.
// Learn it from KEYMAP.md.

@modal = vim_mode == helix_normal | vim_mode == helix_select

// ═══ shared panel keys: spliced into every list panel with `@panel-keys` ══════
@panel-keys = {
  ":":     command_palette::Toggle
  j:       menu::SelectNext  // ours
  k:       menu::SelectPrevious
  h:       menu::SelectParent  // ours
  l:       menu::SelectChild
  "g g":   menu::SelectFirst  // ours
  shift-g: menu::SelectLast  // ours
  ctrl-h:  workspace::ActivatePaneLeft  // ours
  ctrl-j:  workspace::ActivatePaneDown
  ctrl-k:  workspace::ActivatePaneUp
  ctrl-l:  workspace::ActivatePaneRight
  ]: {
    b:       pane::ActivateNextItem
    shift-b: pane::ActivateLastItem
  }
  [: {
    b:       pane::ActivatePreviousItem
    shift-b: pane::ActivateItem(0)
  }
  space: {
    f:       file_finder::Toggle
    /:       pane::DeploySearch
    shift-s: project_symbols::Toggle
    ":":     command_palette::Toggle  // ours
    e:       project_panel::ToggleFocus  // ours
    g:       git_panel::ToggleFocus
    t:       terminal_panel::ToggleFocus
    x:       diagnostics::Deploy  // ours
    q:       workspace::CloseWindow
    w: {
      h: workspace::ActivatePaneLeft
      j: workspace::ActivatePaneDown
      k: workspace::ActivatePaneUp
      l: workspace::ActivatePaneRight
      q: pane::CloseActiveItem
    }
  }
}



// ═══ everywhere: list navigation, cancel, app ═══════════════════════════════
down tab:             menu::SelectNext
up shift-tab:         menu::SelectPrevious
home pageup:          menu::SelectFirst
end pagedown:         menu::SelectLast
enter:                menu::Confirm
ctrl-enter cmd-enter: menu::SecondaryConfirm
escape ctrl-c:        menu::Cancel
cmd-q:                zed::Quit
cmd-o:                workspace::Open
cmd-= cmd-+:          zed::IncreaseBufferFontSize(persist=false)
cmd--:                zed::DecreaseBufferFontSize(persist=false)
cmd-0:                zed::ResetBufferFontSize(persist=false)
menu {
  right: menu::SelectChild
  left:  menu::SelectParent
}

// ═══ the focus tree ═════════════════════════════════════════════════════════
Workspace {
  cmd-s:       workspace::Save
  cmd-shift-s: workspace::SaveAs
  cmd-p:       file_finder::Toggle
  cmd-shift-p: command_palette::Toggle
  cmd-shift-n: workspace::NewWindow
  cmd-shift-t: pane::ReopenClosedItem
  cmd-w:       workspace::CloseActiveDock
  cmd-,:       zed::OpenSettings
  ctrl-/:      terminal_panel::ToggleFocus  // ours
  escape:      workspace::Unfollow
  !Terminal { cmd-n:     workspace::NewFile }
  debugger_running { f5: null }
  debugger_stopped {
    f5:        debugger::Continue
    f10:       debugger::StepOver
    f11:       debugger::StepInto
    shift-f11: debugger::StepOut
  }
  debugger_session {
    f6:       debugger::Pause
    shift-f5: debugger::Stop
  }

  // ─── panes and their items ───────────────────────────────────────────────
  > Pane {
    cmd-w:       pane::CloseActiveItem(close_pinned=false)
    cmd-f:       project_search::ToggleFocus
    cmd-shift-f: pane::DeploySearch
    cmd-shift-h: pane::DeploySearch(replace_enabled)

    > BufferSearchBar {
      escape:      buffer_search::Dismiss
      tab:         buffer_search::FocusEditor
      enter:       search::SelectNextMatch
      shift-enter: search::SelectPreviousMatch
      alt-enter:   search::SelectAllMatches
      cmd-f:       search::FocusSearch
      > Editor {
        ctrl-enter: editor::Newline
        up:         search::PreviousHistoryQuery
        down:       search::NextHistoryQuery
        in_replace {
          enter:     search::ReplaceNext
          cmd-enter: search::ReplaceAll
        }
      }
    }
    > ProjectSearchBar | ProjectSearchView {
      escape:      project_search::ToggleFocus
      cmd-shift-j: project_search::ToggleFilters
      cmd-shift-h: search::ToggleReplace
      > Editor {
        ctrl-enter: editor::Newline
        up:         search::PreviousHistoryQuery
        down:       search::NextHistoryQuery
        in_replace {
          enter:     search::ReplaceNext
          cmd-enter: search::ReplaceAll
        }
      }
    }
    > GitDiff > Editor {
      cmd-enter:       git::Commit
      cmd-shift-enter: git::Amend
    }
    > MarkdownPreview {
      up:          markdown::ScrollUp
      down:        markdown::ScrollDown
      pageup:      markdown::ScrollPageUp
      pagedown:    markdown::ScrollPageDown
      cmd-up:      markdown::ScrollToTop
      cmd-down:    markdown::ScrollToBottom
      cmd-shift-v: markdown::CloseAndReturnToEditor
      cmd-f /:     buffer_search::Deploy
      ctrl-u:      markdown::ScrollPageUp
      ctrl-d:      markdown::ScrollPageDown
      "g g":       markdown::ScrollToTop
      shift-g:     markdown::ScrollToBottom
    }
    > Diagnostics { ctrl-r: diagnostics::ToggleDiagnosticsRefresh }
    > SettingsWindow {
      cmd-w escape: workspace::CloseWindow
      cmd-f:        search::FocusSearch
      left:         settings_editor::ToggleFocusNav
      > NavigationMenu {
        up shift-tab: settings_editor::FocusPreviousNavEntry
        down tab:     settings_editor::FocusNextNavEntry
        right:        settings_editor::ExpandNavEntry
        left:         settings_editor::CollapseNavEntry
        !search {
          j:       settings_editor::FocusNextNavEntry
          k:       settings_editor::FocusPreviousNavEntry
          h:       settings_editor::CollapseNavEntry
          l:       settings_editor::ExpandNavEntry
          "g g":   settings_editor::FocusFirstNavEntry
          shift-g: settings_editor::FocusLastNavEntry
        }
      }
    }

    // the terminal, in this pane or in the dock
    | Dock {
      > Terminal {
        cmd-c:                   terminal::Copy
        cmd-v:                   terminal::Paste
        cmd-a:                   editor::SelectAll
        cmd-f:                   buffer_search::Deploy
        cmd-k:                   terminal::Clear
        cmd-n:                   workspace::NewTerminal
        up:                      terminal::SendKeystroke("up")
        down:                    terminal::SendKeystroke("down")
        pageup:                  terminal::SendKeystroke("pageup")
        pagedown:                terminal::SendKeystroke("pagedown")
        escape:                  terminal::SendKeystroke("escape")
        enter:                   terminal::SendKeystroke("enter")
        ctrl-c:                  terminal::SendKeystroke("ctrl-c")
        ctrl-r:                  terminal::SendKeystroke("ctrl-r")
        ctrl-backspace:          terminal::SendKeystroke("ctrl-w")
        cmd-backspace:           terminal::SendKeystroke("ctrl-u")
        cmd-delete:              terminal::SendKeystroke("ctrl-k")
        cmd-left:                terminal::SendKeystroke("ctrl-a")
        cmd-right:               terminal::SendKeystroke("ctrl-e")
        alt-left alt-b:          terminal::SendText("\u001bb")
        alt-right alt-f:         terminal::SendText("\u001bf")
        alt-delete:              terminal::SendText("\u001bd")
        ctrl-delete:             terminal::SendText("\u001b[3;5~")
        shift-pageup cmd-up:     terminal::ScrollPageUp
        shift-pagedown cmd-down: terminal::ScrollPageDown
        shift-up:                terminal::ScrollLineUp
        shift-down:              terminal::ScrollLineDown
        shift-home cmd-home:     terminal::ScrollToTop
        shift-end cmd-end:       terminal::ScrollToBottom
        ctrl-shift-space:        terminal::ToggleViMode
      }
    }
  }

  // ─── docks and their panels ──────────────────────────────────────────────
  > Dock {
    > ProjectPanel {
      left:             project_panel::CollapseSelectedEntry
      right:            project_panel::ExpandSelectedEntry
      cmd-left:         project_panel::CollapseAllEntries
      cmd-right:        project_panel::ExpandAllEntries
      cmd-n:            project_panel::NewFile
      alt-cmd-n:        project_panel::NewDirectory
      cmd-d:            project_panel::Duplicate
      cmd-x:            project_panel::Cut
      cmd-c:            project_panel::Copy
      cmd-v:            project_panel::Paste
      cmd-z:            project_panel::Undo
      cmd-shift-z:      project_panel::Redo
      enter f2:         project_panel::Rename
      backspace delete: project_panel::Trash(skip_prompt=false)
      cmd-backspace:    project_panel::Trash(skip_prompt)
      cmd-delete:       project_panel::Delete(skip_prompt=false)
      shift-up:         menu::SelectPrevious
      shift-down:       menu::SelectNext
      escape:           menu::Cancel
      not_editing {
        @panel-keys
        j down:  vim::MenuSelectNext
        k up:    vim::MenuSelectPrevious
        h:       project_panel::CollapseSelectedEntry
        l:       project_panel::ExpandSelectedEntry
        -:       project_panel::SelectParent
        ctrl-u:  project_panel::ScrollUp
        ctrl-d:  project_panel::ScrollDown
        enter t: project_panel::OpenPermanent
        escape:  vim::ToggleProjectPanelFocus
        0..9:    vim::Number($)
        a:       project_panel::NewFile  // ours
        shift-a: project_panel::NewDirectory
        r:       project_panel::Rename  // ours
        d:       project_panel::Trash  // ours
        shift-d: project_panel::Delete
        y:       project_panel::Copy  // ours
        shift-y: workspace::CopyRelativePath
        x:       project_panel::Cut  // ours
        p:       project_panel::Paste
        o:       project_panel::OpenSplitVertical  // ours
        shift-o: project_panel::OpenSplitHorizontal
        v:       project_panel::OpenSplitVertical
        s:       workspace::OpenWithSystem
        /:       project_panel::NewSearchInDirectory
        .:       project_panel::OpenContextMenu  // ours
        shift-h: project_panel::ToggleHideGitIgnore  // ours
        "}":     project_panel::SelectNextDirectory
        "{":     project_panel::SelectPrevDirectory
        g:       { .: pane::RevealInProjectPanel }  // ours
        z: {
          t: project_panel::ScrollCursorTop
          z: project_panel::ScrollCursorCenter
          b: project_panel::ScrollCursorBottom
          c: project_panel::CollapseAllEntries  // ours
          d: project_panel::CompareMarkedFiles
        }
        ]: {
          c: project_panel::SelectNextGitEntry
          d: project_panel::SelectNextDiagnostic
        }
        [: {
          c: project_panel::SelectPrevGitEntry
          d: project_panel::SelectPrevDiagnostic
        }
      }
    }

    > OutlinePanel & not_editing {
      @panel-keys
      escape:    menu::Cancel
      left:      outline_panel::CollapseSelectedEntry
      right:     outline_panel::ExpandSelectedEntry
      alt-enter: editor::OpenExcerpts
      j down:    vim::MenuSelectNext
      k up:      vim::MenuSelectPrevious
      h:         outline_panel::CollapseSelectedEntry
      l:         outline_panel::ExpandSelectedEntry
      -:         outline_panel::SelectParent
      ctrl-u:    outline_panel::ScrollUp
      ctrl-d:    outline_panel::ScrollDown
      enter:     editor::ToggleFocus
      0..9:      vim::Number($)
      z: {
        t: outline_panel::ScrollCursorTop
        z: outline_panel::ScrollCursorCenter
        b: outline_panel::ScrollCursorBottom
        c: outline_panel::CollapseAllEntries  // ours
      }
    }

    > GitPanel {
      cmd-enter:        git::Commit
      cmd-shift-enter:  git::Amend
      cmd-ctrl-y:       git::StageAll
      cmd-ctrl-shift-y: git::UnstageAll
      (ChangesList | HistoryList) & !GitBranchSelector & !GitRepositorySelector {
        @panel-keys
        escape: menu::Cancel
        "g f":  menu::Confirm
        .:      git_panel::OpenMenu  // ours
        g: {  // ours
          h: git_panel::ActivateHistoryTab
          c: git_panel::ActivateChangesTab
        }
        ChangesList {
          up:                       git_panel::PreviousEntry
          down:                     git_panel::NextEntry
          cmd-up:                   git_panel::FirstEntry
          cmd-down:                 git_panel::LastEntry
          left h:                   git_panel::CollapseSelectedEntry
          right l:                  git_panel::ExpandSelectedEntry
          x:                        git::ToggleStaged
          shift-space:              git::StageRange
          shift-x:                  git::StageAll
          shift-u:                  git::UnstageAll
          cmd-y:                    git::StageFile
          cmd-shift-y:              git::UnstageFile
          alt-down tab shift-tab i: git_panel::FocusEditor
          backspace delete:         git::RestoreFile(skip_prompt=false)
          s:                        git::ToggleStaged  // ours
          shift-s:                  git::StageAll
          u:                        git::UnstageFile  // ours
          d:                        git::RestoreFile  // ours
          c:                        git::Commit  // ours
          shift-c:                  git::Amend
          shift-i:                  git::GenerateCommitMessage
          f:                        git::Fetch  // ours
          p:                        git::Pull
          shift-p:                  git::Push
          b:                        git::Branch
          shift-t:                  git::StashAll
          o:                        git::OpenFileDiff  // ours
          shift-o:                  git::OpenModifiedFiles
          y:                        workspace::CopyRelativePath  // ours
          z: { z: git::Diff }  // ours
        }
      }
      CommitEditor {
        escape: git::Cancel
        > Editor {
          enter:                editor::Newline
          cmd-enter:            git::Commit
          cmd-shift-enter:      git::Amend
          tab shift-tab alt-up: git_panel::FocusChanges
          alt-tab:              git::GenerateCommitMessage
          ctrl-s:               git::Commit  // ours
          ctrl-j:               git_panel::FocusChanges  // ours
        }
      }
    }

    > AgentPanel {
      cmd-n: agent::NewThread
      > AcpThread {
        cmd-i:          agent::ToggleProfileSelector
        shift-tab:      agent::CycleModeSelector
        alt-tab:        agent::CycleFavoriteModels
        cmd-alt-/:      agent::ToggleModelSelector
        cmd-y:          agent::AllowOnce
        cmd-alt-y:      agent::AllowAlways
        cmd-alt-z:      agent::RejectOnce
        pageup:         agent::ScrollOutputPageUp
        pagedown:       agent::ScrollOutputPageDown
        home:           agent::ScrollOutputToTop
        end:            agent::ScrollOutputToBottom
        up:             agent::ScrollOutputLineUp
        down:           agent::ScrollOutputLineDown
        shift-pageup:   agent::ScrollOutputToPreviousMessage
        shift-pagedown: agent::ScrollOutputToNextMessage
        cmd-f:          agent::ToggleSearch
        > ModeSelector { cmd-enter: menu::Confirm }
        > Editor {
          shift-alt-y:     agent::KeepAll
          shift-alt-z:     agent::RejectAll
          shift-alt-u:     agent::UndoLastReject
          cmd-enter:       agent::ChatWithFollow
          cmd-shift-enter: agent::SendImmediately
          cmd-shift-v:     agent::PasteRaw
          ctrl-;:          agent::OpenAddContextMenu
          start_of_input {
            pageup:    agent::ScrollOutputPageUp
            ctrl-home: agent::ScrollOutputToTop
          }
          end_of_input {
            pagedown: agent::ScrollOutputPageDown
            ctrl-end: agent::ScrollOutputToBottom
          }
          !use_modifier_to_send { enter: agent::Chat }
          use_modifier_to_send {
            cmd-enter: agent::Chat
            enter:     editor::Newline
          }
          shift-enter:     editor::Newline  // ours
        }
        > AcpThreadSearchBar {
          escape:      agent::DismissThreadSearch
          enter:       agent::SelectNextThreadMatch
          shift-enter: agent::SelectPreviousThreadMatch
        }
      }
    }

    > DebugPanel {
      cmd-t: debugger::ToggleThreadPicker
      cmd-i: debugger::ToggleSessionPicker
      > VariableList {
        @panel-keys
        left:             variable_list::CollapseSelectedEntry
        right:            variable_list::ExpandSelectedEntry
        enter:            variable_list::EditVariable
        delete backspace: variable_list::RemoveWatch
        alt-enter:        variable_list::AddWatch
      }
      > BreakpointList {
        @panel-keys
        t:         debugger::ToggleEnableBreakpoint  // ours (space is the leader)
        backspace: debugger::UnsetBreakpoint
        left:      debugger::PreviousBreakpointProperty
        right:     debugger::NextBreakpointProperty
      }
      > DebugConsole > Editor {
        enter:     menu::Confirm
        alt-enter: console::WatchExpression
      }
    }

  }

  > ThreadsSidebar {
    cmd-n:           agents_sidebar::NewThreadInGroup
    left:            menu::SelectParent
    right:           menu::SelectChild
    cmd-f:           agents_sidebar::FocusSidebarFilter
    shift-backspace: agent::ArchiveSelectedThread
    not_searching { shift-r: agent::RenameSelectedThread }
    !Editor {
      @panel-keys
      /:         agents_sidebar::FocusSidebarFilter
      "d d":     agent::RemoveSelectedThread
      o shift-o: agents_sidebar::NewThreadInGroup
    }
  }

  // ─── modals ──────────────────────────────────────────────────────────────
  > Picker > Editor {
    escape:        menu::Cancel
    up:            menu::SelectPrevious
    down:          menu::SelectNext
    tab:           picker::ConfirmCompletion
    alt-enter:     picker::ConfirmInput(secondary=false)
    cmd-alt-enter: picker::ConfirmInput(secondary)
    ctrl-h:        editor::Backspace
    ctrl-u:        editor::DeleteToBeginningOfLine
    ctrl-w:        editor::DeleteToPreviousWordStart
    ctrl-p:        menu::SelectPrevious
    ctrl-n:        menu::SelectNext
    ctrl-j:        menu::SelectNext  // ours
    ctrl-k:        menu::SelectPrevious
    ctrl-l:        picker::TogglePreview  // ours
    ctrl-v:        menu::SecondaryConfirm
  }
  > FileFinder | (FileFinder > Picker > Editor)         { cmd-shift-i:     search::ToggleIncludeIgnored }
  > CommandPalette | (CommandPalette > Picker > Editor) { shift-backspace: command_palette::RemoveSelected }
  > RecentProjects | (RecentProjects > Picker > Editor) {
    shift-backspace: recent_projects::RemoveSelected
    cmd-shift-enter: recent_projects::AddToWorkspace
  }
  > GitBranchSelector | (GitBranchSelector > Picker > Editor) {
    cmd-shift-backspace: branch_picker::DeleteBranch
    cmd-shift-i:         branch_picker::CycleBranchFilter
  }
  > StashList | (StashList > Picker > Editor) {
    ctrl-shift-backspace: stash_picker::DropStashItem
    ctrl-shift-v:         stash_picker::ShowStashItem
  }
  > TabSwitcher {
    ctrl-up:        menu::SelectPrevious
    ctrl-down:      menu::SelectNext
    ctrl-backspace: tab_switcher::CloseSelectedItem
  }
  > GitCommit > Editor & mode == auto_height {
    enter:           editor::Newline
    escape:          menu::Cancel
    cmd-enter:       git::Commit
    cmd-shift-enter: git::Amend
    alt-tab:         git::GenerateCommitMessage
  }
  > InlineAssistant > Editor {
    alt-tab: agent::CycleFavoriteModels
    ctrl-[:  agent::CyclePreviousInlineAssist
    ctrl-]:  agent::CycleNextInlineAssist
  }
  > ConfigureContextServerModal > Editor {
    escape:    menu::Cancel
    enter:     editor::Newline
    cmd-enter: menu::Confirm
  }
  > Prompt {
    left h:  menu::SelectPrevious
    right l: menu::SelectNext
  }
  > ZedPredictModal | OnboardingAiConfigurationModal { escape: menu::Cancel }
}

// ═══ every text input, wherever it sits ═════════════════════════════════════
Editor {
  escape:                    editor::Cancel
  backspace shift-backspace: editor::Backspace
  delete:                    editor::Delete
  tab:                       editor::Tab
  shift-tab:                 editor::Backtab
  alt-backspace:             editor::DeleteToPreviousWordStart(ignore_newlines=false, ignore_brackets=false)
  alt-delete:                editor::DeleteToNextWordEnd(ignore_newlines=false, ignore_brackets=false)
  cmd-backspace:             editor::DeleteToBeginningOfLine
  cmd-delete:                editor::DeleteToEndOfLine
  cmd-x:                     editor::Cut
  cmd-c:                     editor::Copy
  cmd-v:                     editor::Paste
  cmd-z:                     editor::Undo
  cmd-shift-z:               editor::Redo
  cmd-a:                     editor::SelectAll
  left:                      editor::MoveLeft
  shift-left:                editor::SelectLeft
  right:                     editor::MoveRight
  shift-right:               editor::SelectRight
  up:                        editor::MoveUp
  shift-up:                  editor::SelectUp
  down:                      editor::MoveDown
  shift-down:                editor::SelectDown
  alt-left:                  editor::MoveToPreviousWordStart
  alt-shift-left:            editor::SelectToPreviousWordStart
  alt-right:                 editor::MoveToNextWordEnd
  alt-shift-right:           editor::SelectToNextWordEnd
  cmd-left home:             editor::MoveToBeginningOfLine(stop_at_soft_wraps, stop_at_indent)
  cmd-shift-left shift-home: editor::SelectToBeginningOfLine(stop_at_soft_wraps, stop_at_indent)
  cmd-right end:             editor::MoveToEndOfLine(stop_at_soft_wraps)
  cmd-shift-right shift-end: editor::SelectToEndOfLine(stop_at_soft_wraps)
  cmd-up cmd-home:           editor::MoveToBeginning
  cmd-shift-up:              editor::SelectToBeginning
  cmd-down cmd-end:          editor::MoveToEnd
  cmd-shift-down:            editor::SelectToEnd
  pageup:                    editor::MovePageUp
  shift-pageup:              editor::SelectPageUp
  pagedown:                  editor::MovePageDown
  shift-pagedown:            editor::SelectPageDown
  alt-up:                    editor::MoveLineUp
  alt-down:                  editor::MoveLineDown
  alt-shift-up:              editor::DuplicateLineUp
  alt-shift-down:            editor::DuplicateLineDown
  cmd-[:                     editor::Outdent
  cmd-]:                     editor::Indent
  cmd-/:                     editor::ToggleComments(advance_downwards=false, comment_empty_lines)
  cmd-d:                     editor::SelectNext(replace_newest=false)
  cmd-shift-l:               editor::SelectAllMatches
  cmd-shift-i:               editor::Format
  alt-shift-o:               editor::OrganizeImports
  cmd-.:                     editor::ToggleCodeActions
  cmd-i:                     editor::ShowSignatureHelp
  ctrl-space:                editor::ShowCompletions
  f2:                        editor::Rename
  f12:                       editor::GoToDefinition
  ctrl-s:                    workspace::Save  // ours

  // ─── real buffers ────────────────────────────────────────────────────────
  mode == full {
    enter shift-enter: editor::Newline
    cmd-enter:         editor::NewlineBelow
    cmd-shift-enter:   editor::NewlineAbove
    cmd-f:             buffer_search::Deploy
    cmd-e:             buffer_search::UseSelectionForFind
    cmd-shift-o:       outline::Toggle
    ctrl-g:            go_to_line::Toggle
    alt-enter:         editor::OpenSelectionsInMultibuffer
    !AcpThread {
      shift-enter: editor::ExpandExcerpts
      cmd-shift-e: pane::RevealInProjectPanel
      ctrl-enter:  assistant::InlineAssist
    }

    vim_mode == insert {
      escape ctrl-[ ctrl-c: vim::NormalBefore
      ctrl-w:               editor::DeleteToPreviousWordStart(ignore_newlines=false, ignore_brackets=false)
      ctrl-u:               editor::DeleteToBeginningOfLine
      ctrl-t:               vim::Indent
      ctrl-d:               vim::Outdent
      ctrl-r:               vim::PushRegister
      ctrl-o:               vim::TemporaryNormal
      ctrl-k:               vim::PushDigraph()
      insert:               vim::ToggleReplace
    }
    vim_mode == replace {
      escape ctrl-[ ctrl-c: vim::NormalBefore
      backspace:            vim::UndoReplace
      tab:                  vim::Tab
      enter:                vim::Enter
    }

    VimControl & !menu {  // motions and prefix menus, shared by every modal mode
      h left:    vim::Left
      l right:   vim::Right
      j down:    vim::Down
      k up:      vim::Up
      backspace: vim::WrappingLeft
      space:     vim::WrappingRight
      w:         vim::NextWordStart
      e:         vim::NextWordEnd
      b:         vim::PreviousWordStart
      shift-w:   vim::NextWordStart(ignore_punctuation)
      shift-e:   vim::NextWordEnd(ignore_punctuation)
      shift-b:   vim::PreviousWordStart(ignore_punctuation)
      0 home:    vim::StartOfLine
      $ end:     vim::EndOfLine
      ^:         vim::FirstNonWhitespace
      _:         vim::StartOfLineDownward
      + enter:   vim::NextLineStart
      -:         vim::PreviousLineStart
      shift-g:   vim::EndOfDocument
      shift-h:   vim::WindowTop
      shift-m:   vim::WindowMiddle
      shift-l:   vim::WindowBottom
      "{":       vim::StartOfParagraph
      "}":       vim::EndOfParagraph
      (:        vim::SentenceBackward
      ):         vim::SentenceForward
      %:         vim::Matching(match_quotes)
      f:         vim::PushFindForward(before=false, multiline=false)
      t:         vim::PushFindForward(before, multiline=false)
      shift-f:   vim::PushFindBackward(after=false, multiline=false)
      shift-t:   vim::PushFindBackward(after, multiline=false)
      ;:         vim::RepeatFind
      ,:         vim::RepeatFindReversed
      /:         vim::Search
      ?:         vim::Search(backwards)
      n:         vim::MoveToNextMatch
      shift-n:   vim::MoveToPreviousMatch
      *:         vim::MoveToNext
      "#":       vim::MoveToPrevious
      m:         vim::PushMark
      ':         vim::PushJump(line)
      `:         vim::PushJump(line=false)
      ctrl-o:    pane::GoBack
      ctrl-i:    pane::GoForward
      ctrl-^:    pane::AlternateFile
      ctrl-d:    vim::ScrollDown
      ctrl-u:    vim::ScrollUp
      ctrl-f:    vim::PageDown
      ctrl-b:    vim::PageUp
      ctrl-e:    vim::LineDown
      ctrl-y:    vim::LineUp
      v:         vim::ToggleVisual
      shift-v:   vim::ToggleVisualLine
      ctrl-v:    vim::ToggleVisualBlock
      shift-k:   editor::Hover
      shift-r:   vim::ToggleReplace
      q:         vim::ToggleRecord
      shift-q:   vim::ReplayLastRecording
      "@":       vim::PushReplayRegister
      1..9:      vim::Number($)
      VimCount {
        0:   vim::Number(0)
        ":": vim::CountCommand
        %:   vim::GoToPercentage
      }
      ":":       command_palette::Toggle
      .:         vim::Repeat
      ctrl-h:    workspace::ActivatePaneLeft  // ours
      ctrl-j:    workspace::ActivatePaneDown
      ctrl-k:    workspace::ActivatePaneUp
      ctrl-l:    workspace::ActivatePaneRight

      g: {  // goto: only movement lives here
        g:       vim::StartOfDocument
        e:       vim::EndOfDocument
        h:       vim::StartOfLine
        l:       vim::EndOfLine
        s:       vim::FirstNonWhitespace
        t:       vim::WindowTop
        c:       vim::WindowMiddle
        b:       vim::WindowBottom
        d:       editor::GoToDefinition
        shift-d: editor::GoToDeclaration
        y:       editor::GoToTypeDefinition
        i:       editor::GoToImplementation
        r:       editor::FindAllReferences
        a:       pane::AlternateFile
        n:       pane::ActivateNextItem
        p:       pane::ActivatePreviousItem
        f:       editor::OpenSelectedFilename
        x:       editor::OpenUrl
        w:       vim::HelixJumpToWord
        .:       vim::HelixGotoLastModification
        m:       editor::GoToHunk  // ours
        shift-m: editor::GoToPreviousHunk
        o:       outline::Toggle  // ours
        shift-o: project_symbols::Toggle
        j:       vim::Down(display_lines)
        k:       vim::Up(display_lines)
        v:       vim::RestoreVisualSelection
        q:       vim::PushRewrap
        ]:       editor::GoToDiagnostic
        [:       editor::GoToPreviousDiagnostic
      }
      z: {
        z:       editor::ScrollCursorCenter
        t:       editor::ScrollCursorTop
        b:       editor::ScrollCursorBottom
        c:       editor::Fold
        o:       editor::UnfoldLines
        shift-c: editor::FoldRecursive
        shift-o: editor::UnfoldRecursive
        a:       editor::ToggleFold
        shift-a: editor::ToggleFoldRecursive
        shift-m: editor::FoldAll
        shift-r: editor::UnfoldAll
        f:       editor::FoldSelectedRanges
      }
      shift-z: {
        shift-z: pane::CloseActiveItem(save_intent="save_all")
        shift-q: pane::CloseActiveItem(save_intent="skip")
      }

      vim_mode == operator {
        escape ctrl-[ ctrl-c: vim::ClearOperators
        vim_operator == a | vim_operator == i | vim_operator == cs | vim_operator == helix_next | vim_operator == helix_previous {
          w:           vim::Word
          shift-w:     vim::Word(ignore_punctuation)
          s:           vim::Sentence
          p:           vim::Paragraph
          t:           vim::Tag
          a:           vim::Argument
          f:           vim::Method
          c:           vim::Class
          e:           vim::EntireFile
          i:           vim::IndentObj
          shift-i:     vim::IndentObj(include_below)
          ':           vim::Quotes
          `:           vim::BackQuotes
          "\"":        vim::DoubleQuotes
          q:           vim::MiniQuotes
          "|":         vim::VerticalBars
          (:               vim::Parentheses(opening)
          ) b:         vim::Parentheses
          [:           vim::SquareBrackets(opening)
          ] r:         vim::SquareBrackets
          "{":         vim::CurlyBrackets(opening)
          "}" shift-b: vim::CurlyBrackets
          <:           vim::AngleBrackets(opening)
          ">":         vim::AngleBrackets
          helix_mode {
            m: vim::AnyPair
            t: vim::Class
            c: vim::Comment
            x: vim::Tag
          }
        }
        vim_operator == helix_m {
          m: vim::Matching(match_quotes)
          s: vim::PushHelixSurroundAdd
          r: vim::PushHelixSurroundReplace
          d: vim::PushHelixSurroundDelete
        }
        vim_operator == helix_next {
          z:       vim::NextSectionStart
          shift-z: vim::NextSectionEnd
          * / c:   vim::NextComment
          -:       vim::NextLesserIndent
          +:       vim::NextGreaterIndent
          =:       vim::NextSameIndent
          b:       pane::ActivateNextItem
          shift-b: pane::ActivateLastItem
          x:       editor::SelectSmallerSyntaxNode
          d:       editor::GoToDiagnostic
          g:       editor::GoToHunk
          space:   vim::InsertEmptyLineBelow
        }
        vim_operator == helix_previous {
          z:       vim::PreviousSectionStart
          shift-z: vim::PreviousSectionEnd
          * / c:   vim::PreviousComment
          -:       vim::PreviousLesserIndent
          +:       vim::PreviousGreaterIndent
          =:       vim::PreviousSameIndent
          b:       pane::ActivatePreviousItem
          shift-b: pane::ActivateItem(0)
          x:       editor::SelectLargerSyntaxNode
          d:       editor::GoToPreviousDiagnostic
          g:       editor::GoToPreviousHunk
          space:   vim::InsertEmptyLineAbove
        }
      }
      vim_mode == waiting {
        escape ctrl-[ ctrl-c: vim::ClearOperators
        tab:                  vim::Tab
        enter:                vim::Enter
        ctrl-k:               vim::PushDigraph()
      }

      // ─── Helix: normal and select ───────────────────────────────────────
      @modal {
        escape:      vim::SwitchToHelixNormalMode
        ctrl-[:      editor::Cancel
        h left:      vim::WrappingLeft
        l right:     vim::WrappingRight
        j down:      vim::Down(display_lines)
        k up:        vim::Up(display_lines)
        t:           vim::PushFindForward(before, multiline)
        f:           vim::PushFindForward(before=false, multiline)
        shift-t:     vim::PushFindBackward(after, multiline)
        shift-f:     vim::PushFindBackward(after=false, multiline)
        alt-.:       vim::RepeatFind
        shift-g:     vim::HelixGotoLine
        d:           vim::HelixDelete
        alt-d:       editor::Delete
        c:           vim::HelixSubstitute
        alt-c:       vim::HelixSubstituteNoYank
        y:           vim::HelixYank
        p:           vim::HelixPaste
        shift-p:     vim::HelixPaste(before)
        shift-r:     editor::Paste
        r:           vim::PushReplace
        u:           vim::Undo
        shift-u:     editor::Redo
        ctrl-r:      vim::Redo
        ">":         vim::Indent
        <:           vim::Outdent
        =:           vim::AutoIndent
        `:           vim::ConvertToLowerCase
        alt-`:       vim::ConvertToUpperCase
        ~:           vim::ChangeCase
        shift-j:     vim::JoinLines
        ctrl-a:      vim::Increment
        ctrl-x:      vim::Decrement
        x:           vim::HelixSelectLine
        shift-x:     editor::SelectLine
        %:           editor::SelectAll
        s:           vim::HelixSelectRegex
        alt-s:       editor::SplitSelectionIntoLines(keep_selections)
        ;:           vim::HelixCollapseSelection
        alt-;:       vim::OtherEnd
        ,:           vim::HelixKeepNewestSelection
        shift-c:     vim::HelixDuplicateBelow
        alt-shift-c: vim::HelixDuplicateAbove
        _:           vim::HelixTrimSelections
        n:           vim::HelixSelectNext
        shift-n:     vim::HelixSelectPrevious
        *:           buffer_search::UseSelectionForFind
        alt-o:       editor::SelectLargerSyntaxNode
        alt-i:       editor::SelectSmallerSyntaxNode
        alt-p:       editor::SelectPreviousSyntaxNode
        alt-n:       editor::SelectNextSyntaxNode
        alt-b:       editor::MoveToStartOfLargerSyntaxNode
        alt-e:       editor::MoveToEndOfLargerSyntaxNode
        ctrl-c:      editor::ToggleComments(advance_downwards=false, comment_empty_lines=false)
        q:           vim::ReplayLastRecording
        shift-q:     vim::ToggleRecord
        shift-h:     pane::ActivatePreviousItem
        shift-l:     pane::ActivateNextItem
        "\"":        vim::PushRegister
        m:           vim::PushHelixMatch
        ]:           vim::PushHelixNext(around)
        [:           vim::PushHelixPrevious(around)
        o:           vim::InsertLineBelow
        shift-o:     vim::InsertLineAbove
        shift-i:     vim::InsertFirstNonWhitespace
        shift-a:     vim::InsertEndOfLine
        g:       { "r n" "r r" "r i" "r a": null }  // ours: keep g r instant
        space: {
          f:       file_finder::Toggle
          b:       tab_switcher::ToggleAll
          s:       outline::Toggle
          shift-s: project_symbols::Toggle
          /:       pane::DeploySearch
          k:       editor::Hover
          r:       editor::Rename
          a:       editor::ToggleCodeActions
          d:       editor::GoToDiagnostic
          c:       editor::ToggleComments(advance_downwards=false, comment_empty_lines=false)
          y:       editor::Copy
          p:       editor::Paste
          h:       editor::SelectAllMatches
          w: {
            v: pane::SplitRight
            s: pane::SplitDown
            h: workspace::ActivatePaneLeft
            j: workspace::ActivatePaneDown
            k: workspace::ActivatePaneUp
            l: workspace::ActivatePaneRight
            q: pane::CloseActiveItem
          }
          shift-g: {
            l: debugger::Start
            r: debugger::Restart
            c: debugger::Continue
            h: debugger::Pause
            t: debugger::Stop
            i: debugger::StepInto
            o: debugger::StepOut
            n: debugger::StepOver
            b: editor::ToggleBreakpoint
          }
          .:       editor::OpenContextMenu  // ours
          ":":     command_palette::Toggle  // ours
          e:       project_panel::ToggleFocus  // ours
          g:       git_panel::ToggleFocus
          t:       terminal_panel::ToggleFocus
          x:       diagnostics::Deploy  // ours
          m:       markdown::OpenPreviewToTheSide
          u: {  // ours
            w: editor::ToggleSoftWrap
            z: workspace::ToggleCenteredLayout
            i: editor::ToggleInlayHints
            d: editor::ToggleDiagnostics
            b: git::Blame
          }
          q:       workspace::CloseWindow  // ours
          shift-q: zed::Quit
        }
        vim_mode == helix_normal {
          i:       vim::HelixInsert
          a:       vim::HelixAppend
          shift-a: vim::HelixInsertEndOfLine
          showing_code_actions {
            tab:       editor::ContextMenuNext
            shift-tab: editor::ContextMenuPrevious
          }
        }
        vim_mode == helix_select {
          v: vim::NormalBefore
          i: vim::InsertBefore
          a: vim::HelixAppend
        }
      }
    }
  }

  showing_completions {
    enter:       editor::ConfirmCompletion
    shift-enter: editor::ConfirmCompletionReplace
    tab:         editor::ComposeCompletion
    ctrl-d:      vim::ScrollDown
    ctrl-u:      vim::ScrollUp
  }
  showing_code_actions { enter: editor::ConfirmCodeAction }
  (showing_code_actions | showing_completions) {
    up ctrl-p:   editor::ContextMenuPrevious
    down ctrl-n: editor::ContextMenuNext
    pageup:      editor::ContextMenuFirst
    pagedown:    editor::ContextMenuLast
  }
  showing_signature_help & !showing_completions {
    up:   editor::SignatureHelpPrevious
    down: editor::SignatureHelpNext
  }
  renaming     { enter: editor::ConfirmRename }
  in_snippet {
    has_next_tabstop & !showing_completions     { tab:       editor::NextSnippetTabstop }
    has_previous_tabstop & !showing_completions { shift-tab: editor::PreviousSnippetTabstop }
  }
  edit_prediction {
    alt-tab:        editor::AcceptEditPrediction
    ctrl-cmd-right: editor::AcceptNextWordEditPrediction
    ctrl-cmd-down:  editor::AcceptNextLineEditPrediction
    edit_prediction_mode == eager & !showing_completions { tab: editor::AcceptEditPrediction }
  }
  !edit_prediction { alt-tab: editor::ShowEditPrediction }
  editor_agent_diff {
    cmd-y:        agent::Keep
    cmd-alt-z:    agent::Reject
    shift-alt-y:  agent::KeepAll
    shift-alt-z:  agent::RejectAll
    shift-ctrl-r: agent::OpenAgentDiff
  }
  extension == md  { cmd-shift-v: markdown::OpenPreview }
  extension == svg { cmd-shift-v: svg::OpenPreview }
  mode == auto_height {
    ctrl-enter shift-enter: editor::Newline
    ctrl-shift-enter:       editor::NewlineBelow
  }
}
