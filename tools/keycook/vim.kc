// Vim: Zed 1.21.0 vim.json in keycook form. Generated, complete, no imports.
// nesting = &&, `>` headers are Zed's descendant operator, `key: action`, `prefix: { … }`, keys sharing an action share a line.
// 894 bindings, 70 sections; 0 upstream-order fixes carried into child blocks.

VimControl {

  !menu {   // #0
    i: vim::PushObject(around=false)
    a: vim::PushObject(around)
    left h: vim::Left
    backspace: vim::WrappingLeft
    down ctrl-j j: vim::Down
    ctrl-m + enter: vim::NextLineStart
    -: vim::PreviousLineStart
    shift-tab tab: vim::Tab
    up k: vim::Up
    right l: vim::Right
    space: vim::WrappingRight
    end $: vim::EndOfLine
    ^: vim::FirstNonWhitespace
    _: vim::StartOfLineDownward
    shift-g: vim::EndOfDocument
    "{": vim::StartOfParagraph
    "}": vim::EndOfParagraph
    (: vim::SentenceBackward
    ): vim::SentenceForward
    "|": vim::GoToColumn
    w: vim::NextWordStart
    e: vim::NextWordEnd
    b: vim::PreviousWordStart
    shift-w: vim::NextWordStart(ignore_punctuation)
    shift-e: vim::NextWordEnd(ignore_punctuation)
    shift-b: vim::PreviousWordStart(ignore_punctuation)
    /: vim::Search
    ?: vim::Search(backwards)
    *: vim::MoveToNext
    "#": vim::MoveToPrevious
    n: vim::MoveToNextMatch
    shift-n: vim::MoveToPreviousMatch
    %: vim::Matching(match_quotes)
    f: vim::PushFindForward(before=false, multiline=false)
    t: vim::PushFindForward(before, multiline=false)
    shift-f: vim::PushFindBackward(after=false, multiline=false)
    shift-t: vim::PushFindBackward(after, multiline=false)
    m: vim::PushMark
    ': vim::PushJump(line)
    `: vim::PushJump(line=false)
    ;: vim::RepeatFind
    ,: vim::RepeatFindReversed
    ctrl-o: pane::GoBack
    ctrl-i: pane::GoForward
    ctrl-]: editor::GoToDefinition
    ctrl-t: pane::GoToOlderTag
    escape ctrl-[: vim::SwitchToNormalMode
    v: vim::ToggleVisual
    shift-v: vim::ToggleVisualLine
    ctrl-g: vim::ShowLocation
    ctrl-v ctrl-q: vim::ToggleVisualBlock
    shift-k: editor::Hover
    shift-r: vim::ToggleReplace
    0 home: vim::StartOfLine
    ctrl-f pagedown: vim::PageDown
    ctrl-b pageup: vim::PageUp
    ctrl-d: vim::ScrollDown
    ctrl-u: vim::ScrollUp
    ctrl-e: vim::LineDown
    ctrl-y: vim::LineUp
    shift-h: vim::WindowTop
    shift-m: vim::WindowMiddle
    shift-l: vim::WindowBottom
    q: vim::ToggleRecord
    shift-q: vim::ReplayLastRecording
    "@": vim::PushReplayRegister
    1: vim::Number(1)
    2: vim::Number(2)
    3: vim::Number(3)
    4: vim::Number(4)
    5: vim::Number(5)
    6: vim::Number(6)
    7: vim::Number(7)
    8: vim::Number(8)
    9: vim::Number(9)
    ctrl-^: pane::AlternateFile
    .: vim::Repeat
    g: {
      _: vim::EndOfLineDownward
      e: vim::PreviousWordEnd
      shift-e: vim::PreviousWordEnd(ignore_punctuation)
      /: pane::DeploySearch
      d: editor::GoToDefinition
      h: editor::Hover
      shift-r: vim::PushReplaceWithRegister
      shift-a: editor::FindAllReferences
      shift-i: editor::GoToImplementation
      .: editor::ToggleCodeActions
      g: vim::StartOfDocument
      B: editor::BlameHover
      shift-d: editor::GoToDeclaration
      y: editor::GoToTypeDefinition
      x: editor::OpenUrl
      f: editor::OpenSelectedFilename
      n: vim::SelectNextMatch
      shift-n: vim::SelectPreviousMatch
      l: vim::SelectNext
      shift-l: vim::SelectPrevious
      ">": editor::SelectNext(replace_newest)
      <: editor::SelectPrevious(replace_newest)
      a: editor::SelectAllMatches
      s shift-o: outline::Toggle
      shift-s: project_symbols::Toggle
      space: editor::OpenExcerpts
      *: vim::MoveToNext(partial_word)
      "#": vim::MoveToPrevious(partial_word)
      j down: vim::Down(display_lines)
      k up: vim::Up(display_lines)
      $ end: vim::EndOfLine(display_lines)
      0 home: vim::StartOfLine(display_lines)
      shift-m: vim::MiddleOfLine(display_lines)
      ^: vim::FirstNonWhitespace(display_lines)
      v: vim::RestoreVisualSelection
      ]: editor::GoToDiagnostic
      [: editor::GoToPreviousDiagnostic
      i: vim::InsertAtPrevious
      ,: vim::ChangeListNewer
      ;: vim::ChangeListOlder
      r: {
        n: editor::Rename
        r: editor::FindAllReferences
        i: editor::GoToImplementation
        a: editor::ToggleCodeActions
      }
    }
    z: {
      enter: workspace::SendKeystrokes("z t ^")
      -: workspace::SendKeystrokes("z b ^")
      ^: workspace::SendKeystrokes("shift-h k z b ^")
      +: workspace::SendKeystrokes("shift-l j z t ^")
      t: editor::ScrollCursorTop
      z: editor::ScrollCursorCenter
      .: workspace::SendKeystrokes("z z ^")
      b: editor::ScrollCursorBottom
      a: editor::ToggleFold
      shift-a: editor::ToggleFoldRecursive
      c: editor::Fold
      shift-c: editor::FoldRecursive
      o: editor::UnfoldLines
      shift-o: editor::UnfoldRecursive
      f: editor::FoldSelectedRanges
      shift-m: editor::FoldAll
      shift-r: editor::UnfoldAll
      l: vim::ColumnRight
      h: vim::ColumnLeft
      shift-l: vim::HalfPageRight
      shift-h: vim::HalfPageLeft
    }
    shift-z: {
      shift-q: pane::CloseActiveItem(save_intent="skip")
      shift-z: pane::CloseActiveItem(save_intent="save_all")
    }
    ctrl-w: {
      d ] ctrl-]: editor::GoToDefinitionSplit
      shift-d: editor::GoToTypeDefinitionSplit
      space: editor::OpenExcerptsSplit
      g: {
        d: editor::GoToDefinitionSplit
        shift-d: editor::GoToTypeDefinitionSplit
        space: editor::OpenExcerptsSplit
      }
    }
  }

  VimCount {   // #3
    0: vim::Number(0)
    ":": vim::CountCommand
    %: vim::GoToPercentage
  }

  vim_mode == helix_normal & !menu & !BufferSearchBar {   // #9
    j down: vim::Down(display_lines)
    k up: vim::Up(display_lines)
    escape: vim::SwitchToHelixNormalMode
    i: vim::HelixInsert
    a: vim::HelixAppend
    shift-a: vim::HelixInsertEndOfLine
    ctrl-[: editor::Cancel
    g: {
      j down: vim::Down
      k up: vim::Up
    }
  }
}

vim_mode == normal | vim_mode == visual | vim_mode == operator {   // #1
  ]: {
    ]: vim::NextSectionStart
    [: vim::NextSectionEnd
    m: vim::NextMethodStart
    shift-m: vim::NextMethodEnd
    * /: vim::NextComment
    -: vim::NextLesserIndent
    +: vim::NextGreaterIndent
    =: vim::NextSameIndent
    b: pane::ActivateNextItem
    shift-b: pane::ActivateLastItem
    space: vim::InsertEmptyLineBelow
    e: editor::MoveLineDown
    f: workspace::FollowNextCollaborator
    "}": vim::UnmatchedForward(char="}")
    ): vim::UnmatchedForward(char=")")
    r: vim::GoToNextReference
    x: vim::SelectSmallerSyntaxNode
  }
  [: {
    [: vim::PreviousSectionStart
    ]: vim::PreviousSectionEnd
    m: vim::PreviousMethodStart
    shift-m: vim::PreviousMethodEnd
    * /: vim::PreviousComment
    -: vim::PreviousLesserIndent
    +: vim::PreviousGreaterIndent
    =: vim::PreviousSameIndent
    b: pane::ActivatePreviousItem
    shift-b: pane::ActivateItem(0)
    space: vim::InsertEmptyLineAbove
    e: editor::MoveLineUp
    f: workspace::FollowNextCollaborator
    "{": vim::UnmatchedBackward(char="{")
    (: vim::UnmatchedBackward(char="(")
    r: vim::GoToPreviousReference
    x: vim::SelectLargerSyntaxNode
  }
}

vim_mode == normal {   // #2
  i insert: vim::InsertBefore
  a: vim::InsertAfter
  ctrl-[: editor::Cancel
  ":": command_palette::Toggle
  c: vim::PushChange
  shift-c: vim::ChangeToEndOfLine
  d: vim::PushDelete
  delete x: vim::DeleteRight
  y: vim::PushYank
  shift-y: vim::YankLine
  shift-x: vim::DeleteLeft
  ctrl-a: vim::Increment
  ctrl-x: vim::Decrement
  ctrl-r: vim::Redo
  ">": vim::PushIndent
  <: vim::PushOutdent
  =: vim::PushAutoIndent
  "!": vim::PushShellCommand
  g: {
    shift-j: vim::JoinLinesNoWhitespace
    u: vim::PushLowercase
    shift-u: vim::PushUppercase
    ~: vim::PushOppositeCase
    ?: vim::PushRot13
    w q: vim::PushRewrap
    c: vim::PushToggleComments
    b: vim::PushToggleBlockComments
  }
  ]: {
    d: editor::GoToDiagnostic
    c: editor::GoToHunk
  }
  [: {
    d: editor::GoToPreviousDiagnostic
    c: editor::GoToPreviousHunk
  }
}

vim_mode == visual {   // #4
  ":": vim::VisualCommand
  u: vim::ConvertToLowerCase
  shift-u: vim::ConvertToUpperCase
  shift-o: vim::OtherEnd
  o: vim::OtherEndRowAware
  d x delete: vim::VisualDelete
  shift-d shift-x: vim::VisualDeleteLine
  y: vim::VisualYank
  shift-y: vim::VisualYankLine
  p: vim::Paste
  shift-p: vim::Paste(preserve_clipboard)
  c s: vim::Substitute
  shift-r shift-s: vim::SubstituteLine
  ~: vim::ChangeCase
  *: vim::MoveToNext(partial_word)
  "#": vim::MoveToPrevious(partial_word)
  ctrl-a: vim::Increment
  ctrl-x: vim::Decrement
  shift-i: vim::InsertBefore
  shift-a: vim::InsertAfter
  shift-j: vim::JoinLines
  r: vim::PushReplace
  ctrl-c ctrl-[ escape: vim::SwitchToNormalMode
  ">": vim::Indent
  <: vim::Outdent
  =: vim::AutoIndent
  "!": vim::ShellCommand
  i: vim::PushObject(around=false)
  a: vim::PushObject(around)
  "\"": vim::PushRegister
  g: {
    shift-r: vim::Paste(preserve_clipboard)
    ctrl-a: vim::Increment(step)
    ctrl-x: vim::Decrement(step)
    shift-i: vim::VisualInsertFirstNonWhiteSpace
    shift-a: vim::VisualInsertEndOfLine
    shift-j: vim::JoinLinesNoWhitespace
    c: vim::ToggleComments
    b: vim::ToggleBlockComments
    q w: vim::Rewrap
    ?: vim::ConvertToRot13
  }
}

vim_mode == helix_select {   // #5
  v: vim::NormalBefore
  ;: vim::HelixCollapseSelection
  ~: vim::ChangeCase
  ctrl-a: vim::Increment
  ctrl-x: vim::Decrement
  shift-j: vim::JoinLines
  i: vim::InsertBefore
  a: vim::HelixAppend
  o: vim::InsertLineBelow
  shift-o: vim::InsertLineAbove
  p: vim::Paste
  u: vim::Undo
  r: vim::PushReplace
  s: vim::Substitute
  ctrl-pageup: pane::ActivatePreviousItem
  ctrl-pagedown: pane::ActivateNextItem
  .: vim::Repeat
  alt-.: vim::RepeatFind

  !menu & !BufferSearchBar {   // #12
    escape: vim::SwitchToHelixNormalMode
  }
}

vim_mode == insert {   // #6
  ctrl-c ctrl-[ escape: vim::NormalBefore
  ctrl-x: null
  ctrl-w: editor::DeleteToPreviousWordStart(ignore_newlines=false, ignore_brackets=false)
  ctrl-u: editor::DeleteToBeginningOfLine
  ctrl-t: vim::Indent
  ctrl-d: vim::Outdent
  ctrl-y: vim::InsertFromAbove
  ctrl-e: vim::InsertFromBelow
  ctrl-k: vim::PushDigraph()
  ctrl-v ctrl-q ctrl-shift-q: vim::PushLiteral()
  ctrl-shift-v: editor::Paste
  ctrl-r: vim::PushRegister
  insert: vim::ToggleReplace
  ctrl-o: vim::TemporaryNormal
  ctrl-s: editor::ShowSignatureHelp
  ctrl-x: {
    ctrl-o: editor::ShowCompletions
    ctrl-a: assistant::InlineAssist
    ctrl-c: editor::ShowEditPrediction
    ctrl-l: editor::ToggleCodeActions
    ctrl-z: editor::Cancel
    ctrl-e: vim::LineDown
    ctrl-y: vim::LineUp
  }

  !(showing_code_actions | showing_completions) {   // #15
    ctrl-p ctrl-n: editor::ShowWordCompletions
  }
}

showing_completions {   // #7
  ctrl-d: vim::ScrollDown
  ctrl-u: vim::ScrollUp
  ctrl-e: vim::LineDown
  ctrl-y: vim::LineUp
}

(vim_mode == normal | vim_mode == helix_normal) & !menu {   // #8
  escape: editor::Cancel
  shift-d: vim::DeleteToEndOfLine
  shift-j: vim::JoinLines
  shift-y: vim::YankLine
  shift-i: vim::InsertFirstNonWhitespace
  shift-a: vim::InsertEndOfLine
  o: vim::InsertLineBelow
  shift-o: vim::InsertLineAbove
  ~: vim::ChangeCase
  ctrl-a: vim::Increment
  ctrl-x: vim::Decrement
  p: vim::Paste
  shift-p: vim::Paste(before)
  u: vim::Undo
  shift-u: vim::UndoLastLine
  r: vim::PushReplace
  s: vim::Substitute
  shift-s: vim::SubstituteLine
  "\"": vim::PushRegister
  ctrl-pagedown: pane::ActivateNextItem
  ctrl-pageup: pane::ActivatePreviousItem
}

Editor {

  mode == full & VimControl {

    vim_mode == normal & !menu & os == windows {   // #10
      escape: menu::Cancel
    }

    vim_mode == helix_normal & !menu & !BufferSearchBar & os == windows {   // #11
      escape: menu::Cancel
    }
  }

  (vim_mode == helix_normal | vim_mode == helix_select) & showing_code_actions {   // #14
    tab: editor::ContextMenuNext
    shift-tab: editor::ContextMenuPrevious
  }

  vim_mode == waiting & (vim_operator == ys | vim_operator == cs) {   // #19
    escape: vim::SwitchToNormalMode
  }

  mode == auto_height & VimControl {   // #55
    / ? "#" * n shift-n: null
  }

  edit_prediction & edit_prediction_mode == eager & !showing_completions {   // #59
    tab: editor::AcceptEditPrediction
  }
}

(vim_mode == helix_normal | vim_mode == helix_select) & !menu {   // #13
  h left: vim::WrappingLeft
  l right: vim::WrappingRight
  t: vim::PushFindForward(before, multiline)
  f: vim::PushFindForward(before=false, multiline)
  shift-t: vim::PushFindBackward(after, multiline)
  shift-f: vim::PushFindBackward(after=false, multiline)
  alt-.: vim::RepeatFind
  alt-b: editor::MoveToStartOfLargerSyntaxNode
  alt-e: editor::MoveToEndOfLargerSyntaxNode
  shift-g: vim::HelixGotoLine
  shift-r: editor::Paste
  `: vim::ConvertToLowerCase
  alt-`: vim::ConvertToUpperCase
  insert: vim::InsertBefore
  shift-u: editor::Redo
  ctrl-r: vim::Redo
  y: vim::HelixYank
  p: vim::HelixPaste
  shift-p: vim::HelixPaste(before)
  ">": vim::Indent
  <: vim::Outdent
  =: vim::AutoIndent
  d: vim::HelixDelete
  alt-d: editor::Delete
  c: vim::HelixSubstitute
  alt-c: vim::HelixSubstituteNoYank
  s: vim::HelixSelectRegex
  alt-s: editor::SplitSelectionIntoLines(keep_selections)
  ;: vim::HelixCollapseSelection
  alt-;: vim::OtherEnd
  ,: vim::HelixKeepNewestSelection
  shift-c: vim::HelixDuplicateBelow
  alt-shift-c: vim::HelixDuplicateAbove
  %: editor::SelectAll
  x: vim::HelixSelectLine
  *: buffer_search::UseSelectionForFind
  shift-x: editor::SelectLine
  _: vim::HelixTrimSelections
  ctrl-c: editor::ToggleComments(advance_downwards=false, comment_empty_lines=false)
  alt-o: editor::SelectLargerSyntaxNode
  alt-i: editor::SelectSmallerSyntaxNode
  alt-p: editor::SelectPreviousSyntaxNode
  alt-n: editor::SelectNextSyntaxNode
  n: vim::HelixSelectNext
  shift-n: vim::HelixSelectPrevious
  q: vim::ReplayLastRecording
  shift-q: vim::ToggleRecord
  shift-l: pane::ActivateNextItem
  shift-h: pane::ActivatePreviousItem
  "z c": editor::ScrollCursorCenter
  ":": command_palette::Toggle
  m: vim::PushHelixMatch
  ]: vim::PushHelixNext(around)
  [: vim::PushHelixPrevious(around)
  ctrl-s: editor::SaveLocation
  space: {
    p: editor::Paste
    c: editor::ToggleComments(advance_downwards=false, comment_empty_lines=false)
    b: tab_switcher::ToggleAll
    f: file_finder::Toggle
    k: editor::Hover
    s: outline::Toggle
    shift-s: project_symbols::Toggle
    d: editor::GoToDiagnostic
    r: editor::Rename
    a: editor::ToggleCodeActions
    h: editor::SelectAllMatches
    y: editor::Copy
    /: pane::DeploySearch
    w: {
      v r: pane::SplitRight
      s d: pane::SplitDown
      h: workspace::ActivatePaneLeft
      j: workspace::ActivatePaneDown
      k: workspace::ActivatePaneUp
      l: workspace::ActivatePaneRight
      q: pane::CloseActiveItem
    }
    shift-g: {
      l: debugger::Start
      r: debugger::Restart
      b: editor::ToggleBreakpoint
      c: debugger::Continue
      h: debugger::Pause
      i: debugger::StepInto
      o: debugger::StepOut
      n: debugger::StepOver
      t: debugger::Stop
      ctrl-l: editor::EditLogBreakpoint
    }
  }
  g: {
    e: vim::EndOfDocument
    h: vim::StartOfLine
    l: vim::EndOfLine
    s: vim::FirstNonWhitespace
    t: vim::WindowTop
    c: vim::WindowMiddle
    b: vim::WindowBottom
    r: editor::FindAllReferences
    i: editor::GoToImplementation
    a: pane::AlternateFile
    n: pane::ActivateNextItem
    p: pane::ActivatePreviousItem
    w: vim::HelixJumpToWord
    .: vim::HelixGotoLastModification
    o: editor::ToggleSelectedDiffHunks
    shift-o: git::ToggleStaged
    shift-r: git::Restore
    u: git::StageAndNext
    shift-u: git::UnstageAndNext
    q: vim::PushRewrap
  }
}

(vim_mode == insert | vim_mode == normal) & showing_signature_help & !showing_completions {   // #16
  ctrl-p: editor::SignatureHelpPrevious
  ctrl-n: editor::SignatureHelpNext
}

vim_mode == replace {   // #17
  ctrl-c ctrl-[ escape: vim::NormalBefore
  ctrl-k: vim::PushDigraph()
  ctrl-v ctrl-q ctrl-shift-q: vim::PushLiteral()
  ctrl-shift-v: editor::Paste
  backspace: vim::UndoReplace
  tab: vim::Tab
  enter: vim::Enter
  insert: vim::InsertBefore
}

vim_mode == waiting {   // #18
  tab: vim::Tab
  enter: vim::Enter
  ctrl-c ctrl-[ escape: vim::ClearOperators
  ctrl-k: vim::PushDigraph()
  ctrl-v ctrl-q: vim::PushLiteral()
}

vim_mode == operator {   // #20
  ctrl-c ctrl-[ escape: vim::ClearOperators
  "g c": vim::Comment
}

vim_operator == a | vim_operator == i | vim_operator == cs | vim_operator == helix_next | vim_operator == helix_previous {   // #21
  w: vim::Word
  shift-w: vim::Word(ignore_punctuation)
  t: vim::Tag
  s: vim::Sentence
  p: vim::Paragraph
  ': vim::Quotes
  `: vim::BackQuotes
  "\"": vim::DoubleQuotes
  q: vim::MiniQuotes
  "|": vim::VerticalBars
  (: vim::Parentheses(opening)
  ) b: vim::Parentheses
  [: vim::SquareBrackets(opening)
  ] r: vim::SquareBrackets
  "{": vim::CurlyBrackets(opening)
  "}" shift-b: vim::CurlyBrackets
  <: vim::AngleBrackets(opening)
  ">": vim::AngleBrackets
  a: vim::Argument
  i: vim::IndentObj
  shift-i: vim::IndentObj(include_below)
  f: vim::Method
  c: vim::Class
  e: vim::EntireFile
}

(vim_operator == a | vim_operator == i | vim_operator == helix_next | vim_operator == helix_previous) & helix_mode {   // #22
  m: vim::AnyPair
  t: vim::Class
  c: vim::Comment
  x: vim::Tag
}

vim_operator == helix_m {   // #23
  m: vim::Matching(match_quotes)
  s: vim::PushHelixSurroundAdd
  r: vim::PushHelixSurroundReplace
  d: vim::PushHelixSurroundDelete
}

vim_operator == helix_next {   // #24
  z: vim::NextSectionStart
  shift-z: vim::NextSectionEnd
  * / c: vim::NextComment
  -: vim::NextLesserIndent
  +: vim::NextGreaterIndent
  =: vim::NextSameIndent
  b: pane::ActivateNextItem
  shift-b: pane::ActivateLastItem
  x: editor::SelectSmallerSyntaxNode
  d: editor::GoToDiagnostic
  g: editor::GoToHunk
  space: vim::InsertEmptyLineBelow
}

vim_operator == helix_previous {   // #25
  z: vim::PreviousSectionStart
  shift-z: vim::PreviousSectionEnd
  * / c: vim::PreviousComment
  -: vim::PreviousLesserIndent
  +: vim::PreviousGreaterIndent
  =: vim::PreviousSameIndent
  b: pane::ActivatePreviousItem
  shift-b: pane::ActivateItem(0)
  x: editor::SelectLargerSyntaxNode
  d: editor::GoToPreviousDiagnostic
  g: editor::GoToPreviousHunk
  space: vim::InsertEmptyLineAbove
}

vim_operator == c {   // #26
  c: vim::CurrentLine
  x: vim::Exchange
  d: editor::Rename
  s: vim::PushChangeSurrounds()
}

vim_operator == d {   // #27
  d: vim::CurrentLine
  s: vim::PushDeleteSurrounds
  v: vim::PushForcedMotion
  o: editor::ToggleSelectedDiffHunks
  shift-o: git::ToggleStaged
  p: git::Restore
  u: git::StageAndNext
  shift-u: git::UnstageAndNext
}

vim_operator == gu {   // #28
  "g u" u: vim::CurrentLine
}

vim_operator == gU {   // #29
  "g shift-u" shift-u: vim::CurrentLine
}

vim_operator == g~ {   // #30
  "g ~" ~: vim::CurrentLine
}

vim_operator == g? {   // #31
  "g ?" ?: vim::CurrentLine
}

vim_operator == gq {   // #32
  q w: vim::CurrentLine
  g: {
    q w: vim::CurrentLine
  }
}

vim_operator == y {   // #33
  y: vim::CurrentLine
  v: vim::PushForcedMotion
  s: vim::PushAddSurrounds()
}

vim_operator == ys {   // #34
  s: vim::CurrentLine
}

vim_operator == >  {   // #35
  ">": vim::CurrentLine
}

vim_operator == < {   // #36
  <: vim::CurrentLine
}

vim_operator == eq {   // #37
  =: vim::CurrentLine
}

vim_operator == sh {   // #38
  "!": vim::CurrentLine
}

vim_operator == gc {   // #39
  c: vim::CurrentLine
}

vim_operator == gb {   // #40
  c: vim::CurrentLine
}

vim_operator == gR {   // #41
  r shift-r: vim::CurrentLine
}

vim_operator == cx {   // #42
  x: vim::CurrentLine
  c: vim::ClearExchange
}

vim_mode == literal {   // #43
  ctrl-@: vim::Literal(["ctrl-@", "\u0000"])
  ctrl-a: vim::Literal(["ctrl-a", "\u0001"])
  ctrl-b: vim::Literal(["ctrl-b", "\u0002"])
  ctrl-c: vim::Literal(["ctrl-c", "\u0003"])
  ctrl-d: vim::Literal(["ctrl-d", "\u0004"])
  ctrl-e: vim::Literal(["ctrl-e", "\u0005"])
  ctrl-f: vim::Literal(["ctrl-f", "\u0006"])
  ctrl-g: vim::Literal(["ctrl-g", "\u0007"])
  ctrl-h: vim::Literal(["ctrl-h", "\b"])
  ctrl-i: vim::Literal(["ctrl-i", "\t"])
  ctrl-j: vim::Literal(["ctrl-j", "\n"])
  ctrl-k: vim::Literal(["ctrl-k", "\u000b"])
  ctrl-l: vim::Literal(["ctrl-l", "\f"])
  ctrl-m: vim::Literal(["ctrl-m", "\r"])
  ctrl-n: vim::Literal(["ctrl-n", "\u000e"])
  ctrl-o: vim::Literal(["ctrl-o", "\u000f"])
  ctrl-p: vim::Literal(["ctrl-p", "\u0010"])
  ctrl-q: vim::Literal(["ctrl-q", "\u0011"])
  ctrl-r: vim::Literal(["ctrl-r", "\u0012"])
  ctrl-s: vim::Literal(["ctrl-s", "\u0013"])
  ctrl-t: vim::Literal(["ctrl-t", "\u0014"])
  ctrl-u: vim::Literal(["ctrl-u", "\u0015"])
  ctrl-v: vim::Literal(["ctrl-v", "\u0016"])
  ctrl-w: vim::Literal(["ctrl-w", "\u0017"])
  ctrl-x: vim::Literal(["ctrl-x", "\u0018"])
  ctrl-y: vim::Literal(["ctrl-y", "\u0019"])
  ctrl-z: vim::Literal(["ctrl-z", "\u001a"])
  ctrl-[: vim::Literal(["ctrl-[", "\u001b"])
  ctrl-\: vim::Literal(["ctrl-\\", "\u001c"])
  ctrl-]: vim::Literal(["ctrl-]", "\u001d"])
  ctrl-^: vim::Literal(["ctrl-^", "\u001e"])
  ctrl-_: vim::Literal(["ctrl-_", "\u001f"])
  escape: vim::Literal(["escape", "\u001b"])
  enter: vim::Literal(["enter", "\r"])
  tab: vim::Literal(["tab", "\t"])
  backspace: vim::Literal(["backspace", "\b"])
  delete: vim::Literal(["delete", "\u007f"])
}

BufferSearchBar & !in_replace {   // #44
  enter: vim::SearchSubmit
  escape: buffer_search::Dismiss
}

VimControl & !menu | !Editor & !Terminal {   // #45
  ctrl-w: null
  ctrl-w: {
    left ctrl-h h: workspace::ActivatePaneLeft
    right ctrl-l l: workspace::ActivatePaneRight
    up ctrl-k k: workspace::ActivatePaneUp
    down ctrl-j j: workspace::ActivatePaneDown
    shift-left: workspace::SwapPaneLeft
    shift-right: workspace::SwapPaneRight
    shift-up: workspace::SwapPaneUp
    shift-down: workspace::SwapPaneDown
    x ctrl-x: workspace::SwapPaneAdjacent
    shift-h: workspace::MovePaneLeft
    shift-l: workspace::MovePaneRight
    shift-k: workspace::MovePaneUp
    shift-j: workspace::MovePaneDown
    ">": vim::ResizePaneRight
    <: vim::ResizePaneLeft
    -: vim::ResizePaneDown
    +: vim::ResizePaneUp
    _: vim::MaximizePane
    =: vim::ResetPaneSizes
    w ctrl-w: workspace::ActivateNextPane
    p ctrl-p shift-w ctrl-shift-w: workspace::ActivatePreviousPane
    ctrl-v v: pane::SplitVertical
    shift-s ctrl-s s: pane::SplitHorizontal
    ctrl-c c ctrl-q q: pane::CloseActiveItem
    ctrl-a a: pane::CloseAllItems
    ctrl-o o: workspace::CloseInactiveTabsAndPanes
    ctrl-n n: workspace::NewFileSplitHorizontal
    g: {
      t: pane::ActivateNextItem
      shift-t: pane::ActivatePreviousItem
    }
    ctrl-g: {
      t: pane::ActivateNextItem
      shift-t: pane::ActivatePreviousItem
    }
  }
  g: {
    t: vim::GoToTab
    shift-t: vim::GoToPreviousTab
  }
}

!Editor & !Terminal {   // #46
  ":": command_palette::Toggle
  "g /": pane::DeploySearch
  space: {
    /: pane::DeploySearch
    f: file_finder::Toggle
    shift-s: project_symbols::Toggle
    w: {
      h: workspace::ActivatePaneLeft
      j: workspace::ActivatePaneDown
      k: workspace::ActivatePaneUp
      l: workspace::ActivatePaneRight
      q: pane::CloseActiveItem
    }
  }
  ]: {
    b: pane::ActivateNextItem
    shift-b: pane::ActivateLastItem
  }
  [: {
    b: pane::ActivatePreviousItem
    shift-b: pane::ActivateItem(0)
  }
}

ProjectPanel & not_editing {   // #47
  ":": command_palette::Toggle
  %: project_panel::NewFile
  /: project_panel::NewSearchInDirectory
  d: project_panel::NewDirectory
  enter t: project_panel::OpenPermanent
  escape: vim::ToggleProjectPanelFocus
  h: project_panel::CollapseSelectedEntry
  j down: vim::MenuSelectNext
  k up: vim::MenuSelectPrevious
  l: project_panel::ExpandSelectedEntry
  shift-d: project_panel::Delete
  shift-r: project_panel::Rename
  v: project_panel::OpenSplitVertical
  o: project_panel::OpenSplitHorizontal
  p: project_panel::Open
  x: project_panel::RevealInFileManager
  s: workspace::OpenWithSystem
  "}": project_panel::SelectNextDirectory
  "{": project_panel::SelectPrevDirectory
  shift-g: menu::SelectLast
  "g g": menu::SelectFirst
  -: project_panel::SelectParent
  ctrl-u: project_panel::ScrollUp
  ctrl-d: project_panel::ScrollDown
  0: vim::Number(0)
  1: vim::Number(1)
  2: vim::Number(2)
  3: vim::Number(3)
  4: vim::Number(4)
  5: vim::Number(5)
  6: vim::Number(6)
  7: vim::Number(7)
  8: vim::Number(8)
  9: vim::Number(9)
  z: {
    d: project_panel::CompareMarkedFiles
    t: project_panel::ScrollCursorTop
    z c: project_panel::ScrollCursorCenter
    b: project_panel::ScrollCursorBottom
  }
  ]: {
    c: project_panel::SelectNextGitEntry
    d: project_panel::SelectNextDiagnostic
  }
  [: {
    c: project_panel::SelectPrevGitEntry
    d: project_panel::SelectPrevDiagnostic
  }
}

OutlinePanel {

  not_editing {   // #48
    h: outline_panel::CollapseSelectedEntry
    j down: vim::MenuSelectNext
    k up: vim::MenuSelectPrevious
    l: outline_panel::ExpandSelectedEntry
    shift-g: menu::SelectLast
    "g g": menu::SelectFirst
    -: outline_panel::SelectParent
    enter: editor::ToggleFocus
    /: menu::Cancel
    ctrl-u: outline_panel::ScrollUp
    ctrl-d: outline_panel::ScrollDown
    0: vim::Number(0)
    1: vim::Number(1)
    2: vim::Number(2)
    3: vim::Number(3)
    4: vim::Number(4)
    5: vim::Number(5)
    6: vim::Number(6)
    7: vim::Number(7)
    8: vim::Number(8)
    9: vim::Number(9)
    z: {
      t: outline_panel::ScrollCursorTop
      z c: outline_panel::ScrollCursorCenter
      b: outline_panel::ScrollCursorBottom
    }
  }

  editing {   // #49
    enter: menu::Cancel
  }
}

GitGraph {   // #50
  tab: git_graph::FocusNextTabStop
  shift-tab: git_graph::FocusPreviousTabStop

  !GitGraphSearchBar {   // #52
    j: vim::MenuSelectNext
    k: vim::MenuSelectPrevious
    ctrl-d: git_graph::ScrollDown
    ctrl-u: git_graph::ScrollUp
    shift-g: menu::SelectLast
    "g g": menu::SelectFirst
  }
}

GitGraphSearchBar > Editor {   // #51
  tab: git_graph::FocusNextTabStop
  shift-tab: git_graph::FocusPreviousTabStop
}

GitPanel {

  (ChangesList | HistoryList) & !GitBranchSelector & !GitRepositorySelector {   // #53
    j: menu::SelectNext
    k: menu::SelectPrevious
    "g f": menu::Confirm
  }

  ChangesList & !GitBranchSelector & !GitRepositorySelector {   // #54
    h: git_panel::CollapseSelectedEntry
    l: git_panel::ExpandSelectedEntry
    shift-g: menu::SelectLast
    i: git_panel::FocusEditor
    x: git::ToggleStaged
    shift-x: git::StageAll
    shift-u: git::UnstageAll
    g: {
      g: menu::SelectFirst
      x: git::StageRange
    }
  }
}

Picker > Editor {   // #56
  ctrl-h: editor::Backspace
  ctrl-u: editor::DeleteToBeginningOfLine
  ctrl-w: editor::DeleteToPreviousWordStart
  ctrl-p: menu::SelectPrevious
  ctrl-n: menu::SelectNext
}

GitCommit > Editor & VimControl & vim_mode == normal {   // #57
  ctrl-c escape: menu::Cancel
}

CommitEditor > Editor & VimControl & !menu {   // #58
  tab shift-tab: git_panel::FocusChanges
}

MessageEditor > Editor & VimControl {   // #60
  enter: agent::Chat
}

SettingsWindow > NavigationMenu & !search {   // #61
  l: settings_editor::ExpandNavEntry
  h: settings_editor::CollapseNavEntry
  k: settings_editor::FocusPreviousNavEntry
  j: settings_editor::FocusNextNavEntry
  "g g": settings_editor::FocusFirstNavEntry
  shift-g: settings_editor::FocusLastNavEntry
}

MarkdownPreview {   // #62
  ctrl-u: markdown::ScrollPageUp
  ctrl-d: markdown::ScrollPageDown
  ctrl-y: markdown::ScrollUp
  ctrl-e: markdown::ScrollDown
  "g g": markdown::ScrollToTop
  shift-g: markdown::ScrollToBottom
  /: buffer_search::Deploy
}

FileHistoryView {   // #63
  j: menu::SelectNext
  k: menu::SelectPrevious
  "g g": menu::SelectFirst
  shift-g: menu::SelectLast
}

NotebookEditor > Editor & VimControl & vim_mode == normal {   // #64
  j: notebook::NotebookMoveDown
  k: notebook::NotebookMoveUp
  escape: notebook::EnterCommandMode
}

NotebookEditor & notebook_mode == command {   // #65
  j: menu::SelectNext
  k: menu::SelectPrevious
  "g g": menu::SelectFirst
  shift-g: menu::SelectLast
  i a enter: notebook::EnterEditMode
  shift-enter: notebook::RunAndAdvance
  ctrl-enter: notebook::Run
}

ThreadsSidebar & !Editor {   // #66
  j: menu::SelectNext
  k: menu::SelectPrevious
  h: menu::SelectParent
  l: menu::SelectChild
  "g g": menu::SelectFirst
  shift-g: menu::SelectLast
  /: agents_sidebar::FocusSidebarFilter
  "d d": agent::RemoveSelectedThread
  o shift-o: agents_sidebar::NewThreadInGroup
  "] p": multi_workspace::NextProject
  "[ p": multi_workspace::PreviousProject
  z: {
    c: menu::SelectParent
    o: menu::SelectChild
    a: editor::ToggleFold
    shift-m: editor::FoldAll
    shift-r: editor::UnfoldAll
  }
}

ThreadsSidebar > Editor & VimControl & vim_mode == normal {   // #67
  j: editor::MoveDown
  k: editor::MoveUp
  /: vim::SwitchToInsertMode
  escape: menu::Cancel
  enter: editor::Newline
}

SkillCreator {   // #68
  tab: skill_creator::FocusNextField
  shift-tab: skill_creator::FocusPreviousField
}

SkillCreator > Editor {   // #69
  tab: skill_creator::FocusNextField
  shift-tab: skill_creator::FocusPreviousField
}
