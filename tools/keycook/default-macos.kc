GitPanel {   // #73,#79
  cmd-1: git_panel::ActivateChangesTab
  cmd-2: git_panel::ActivateHistoryTab
  cmd-ctrl-y: git::StageAll
  cmd-ctrl-shift-y: git::UnstageAll
  cmd-enter: git::Commit
  cmd-shift-enter: git::Amend
  ctrl-g: {
    ctrl-g: git::Fetch
    up: git::Push
    down: git::Pull
    shift-down: git::PullRebase
    shift-up: git::ForcePush
    d: git::Diff
    backspace: git::RestoreTrackedFiles
    shift-backspace: git::TrashUntrackedFiles
  }

  (ChangesList | HistoryList) & !GitBranchSelector & !GitRepositorySelector {   // #74
    up shift-up: menu::SelectPrevious
    down shift-down: menu::SelectNext
    enter: menu::Confirm
    escape: menu::Cancel
  }

  ChangesList & !GitBranchSelector & !GitRepositorySelector {   // #75
    up: git_panel::PreviousEntry
    down: git_panel::NextEntry
    cmd-up: git_panel::FirstEntry
    cmd-down: git_panel::LastEntry
    left: git_panel::CollapseSelectedEntry
    right: git_panel::ExpandSelectedEntry
    cmd-alt-y space: git::ToggleStaged
    shift-space: git::StageRange
    cmd-y: git::StageFile
    cmd-shift-y: git::UnstageFile
    cmd-alt-c: workspace::CopyPath
    alt-cmd-shift-c: workspace::CopyRelativePath
    alt-down tab shift-tab: git_panel::FocusEditor
    backspace delete: git::RestoreFile(skip_prompt=false)
    cmd-backspace cmd-delete: git::RestoreFile(skip_prompt)
  }

  CommitEditor {   // #76
    escape: git::Cancel
  }
}

