// Base: Zed 1.21.0 default-macos.json in keycook form. Generated, complete, no imports.
// nesting = &&, `>` headers are Zed's descendant operator, `key: action`, `prefix: { … }`, keys sharing an action share a line.
// 934 bindings, 134 sections; 0 upstream-order fixes carried into child blocks.

f4: debugger::Start
home shift-pageup pageup cmd-up: menu::SelectFirst
end shift-pagedown pagedown cmd-down: menu::SelectLast
tab ctrl-n down: menu::SelectNext
shift-tab ctrl-p up: menu::SelectPrevious
enter: menu::Confirm
ctrl-enter cmd-enter: menu::SecondaryConfirm
cmd-escape ctrl-escape ctrl-c escape: menu::Cancel
alt-shift-enter: menu::Restart
cmd-shift-w: workspace::CloseWindow
shift-escape: workspace::ToggleZoom
cmd-o: workspace::Open
cmd-= cmd-+: zed::IncreaseBufferFontSize(persist=false)
cmd--: zed::DecreaseBufferFontSize(persist=false)
cmd-0: zed::ResetBufferFontSize(persist=false)
cmd-alt-,: zed::OpenSettingsFile
cmd-q: zed::Quit
cmd-h: zed::Hide
alt-cmd-h: zed::HideOthers
cmd-m: zed::Minimize
ctrl-cmd-z: edit_prediction::RatePredictions
ctrl-cmd-i: edit_prediction::ToggleMenu
ctrl-cmd-l: lsp_tool::ToggleMenu
ctrl-cmd-c: editor::DisplayCursorNames
ctrl-cmd-s: workspace::ToggleWorktreeSecurity
ctrl-alt-cmd-f: workspace::FollowNextCollaborator
cmd-shift-c: collab_panel::ToggleFocus
cmd-alt-i: dev::ToggleInspector
ctrl-alt-shift-p: dev::ToggleFpsOverlay
ctrl-alt-shift-o: dev::ResetFrameOverlayStats

menu {   // #1
  right: menu::SelectChild
  left: menu::SelectParent
}

Editor {   // #2,#39,#52
  escape: editor::Cancel
  shift-backspace ctrl-h backspace: editor::Backspace
  ctrl-d delete: editor::Delete
  tab: editor::Tab
  shift-tab: editor::Backtab
  ctrl-t: editor::Transpose
  ctrl-k: editor::KillRingCut
  ctrl-y: editor::KillRingYank
  cmd-backspace: editor::DeleteToBeginningOfLine
  cmd-delete: editor::DeleteToEndOfLine
  alt-backspace ctrl-w: editor::DeleteToPreviousWordStart(ignore_newlines=false, ignore_brackets=false)
  alt-delete: editor::DeleteToNextWordEnd(ignore_newlines=false, ignore_brackets=false)
  cmd-x: editor::Cut
  cmd-c: editor::Copy
  cmd-v: editor::Paste
  cmd-z: editor::Undo
  cmd-shift-z: editor::Redo
  up ctrl-p: editor::MoveUp
  ctrl-up: editor::MoveToStartOfParagraph
  pageup: editor::MovePageUp
  shift-pageup: editor::SelectPageUp
  cmd-pageup: editor::PageUp
  ctrl-pageup: editor::LineUp
  down ctrl-n: editor::MoveDown
  ctrl-down: editor::MoveToEndOfParagraph
  pagedown: editor::MovePageDown
  shift-pagedown: editor::SelectPageDown
  cmd-pagedown: editor::PageDown
  ctrl-pagedown: editor::LineDown
  ctrl-b left: editor::MoveLeft
  ctrl-f right: editor::MoveRight
  ctrl-l: editor::ScrollCursorCenter
  alt-left: editor::MoveToPreviousWordStart
  alt-right: editor::MoveToNextWordEnd
  cmd-left home: editor::MoveToBeginningOfLine(stop_at_soft_wraps, stop_at_indent)
  ctrl-a: editor::MoveToBeginningOfLine(stop_at_soft_wraps=false, stop_at_indent)
  cmd-right end: editor::MoveToEndOfLine(stop_at_soft_wraps)
  ctrl-e: editor::MoveToEndOfLine(stop_at_soft_wraps=false)
  cmd-up cmd-home: editor::MoveToBeginning
  cmd-down cmd-end: editor::MoveToEnd
  shift-up ctrl-shift-p: editor::SelectUp
  shift-down ctrl-shift-n: editor::SelectDown
  shift-left ctrl-shift-b: editor::SelectLeft
  shift-right ctrl-shift-f: editor::SelectRight
  alt-shift-left: editor::SelectToPreviousWordStart
  alt-shift-right: editor::SelectToNextWordEnd
  ctrl-shift-up: editor::SelectToStartOfParagraph
  ctrl-shift-down: editor::SelectToEndOfParagraph
  cmd-shift-up: editor::SelectToBeginning
  cmd-shift-down: editor::SelectToEnd
  cmd-a: editor::SelectAll
  cmd-l: editor::SelectLine
  cmd-shift-i: editor::Format
  alt-shift-o: editor::OrganizeImports
  cmd-shift-left shift-home ctrl-shift-a: editor::SelectToBeginningOfLine(stop_at_soft_wraps, stop_at_indent)
  cmd-shift-right shift-end ctrl-shift-e: editor::SelectToEndOfLine(stop_at_soft_wraps)
  ctrl-v: editor::MovePageDown(center_cursor)
  ctrl-shift-v: editor::MovePageUp(center_cursor)
  ctrl-cmd-space: editor::ShowCharacterPalette
  cmd-;: editor::ToggleLineNumbers
  cmd-': editor::ToggleSelectedDiffHunks
  "cmd-\"": editor::ExpandAllDiffHunks
  cmd-i: editor::ShowSignatureHelp
  f9: editor::ToggleBreakpoint
  shift-f9: editor::EditLogBreakpoint
  ctrl-f12: editor::GoToDeclaration
  alt-ctrl-f12: editor::GoToDeclarationSplit
  ctrl-cmd-e: editor::ToggleEditPrediction
  cmd-[: editor::Outdent
  cmd-]: editor::Indent
  cmd-ctrl-p: editor::AddSelectionAbove(skip_soft_wrap=false)
  cmd-alt-up: editor::AddSelectionAbove(skip_soft_wrap)
  cmd-ctrl-n: editor::AddSelectionBelow(skip_soft_wrap=false)
  cmd-alt-down: editor::AddSelectionBelow(skip_soft_wrap)
  cmd-shift-k: editor::DeleteLine
  alt-up: editor::MoveLineUp
  alt-down: editor::MoveLineDown
  alt-shift-up: editor::DuplicateLineUp
  alt-shift-down: editor::DuplicateLineDown
  cmd-ctrl-left ctrl-shift-left: editor::SelectSmallerSyntaxNode
  cmd-ctrl-right ctrl-shift-right: editor::SelectLargerSyntaxNode
  cmd-ctrl-up: editor::SelectPreviousSyntaxNode
  cmd-ctrl-down: editor::SelectNextSyntaxNode
  cmd-d: editor::SelectNext(replace_newest=false)
  cmd-shift-l cmd-f2: editor::SelectAllMatches
  ctrl-cmd-d: editor::SelectPrevious(replace_newest=false)
  cmd-/: editor::ToggleComments(advance_downwards=false, comment_empty_lines)
  shift-alt-a: editor::ToggleBlockComments
  f8: editor::GoToDiagnostic(severity={"min": "hint", "max": "error"})
  shift-f8: editor::GoToPreviousDiagnostic(severity={"min": "hint", "max": "error"})
  f2: editor::Rename
  f12: editor::GoToDefinition
  alt-f12: editor::GoToDefinitionSplit
  cmd-f12: editor::GoToTypeDefinition
  shift-f12: editor::GoToImplementation
  alt-cmd-f12: editor::GoToTypeDefinitionSplit
  alt-shift-f12: editor::FindAllReferences
  cmd-| ctrl-m: editor::MoveToEnclosingBracket
  alt-cmd-[: editor::Fold
  alt-cmd-]: editor::UnfoldLines
  ctrl-space: editor::ShowCompletions
  ctrl-shift-space: editor::ShowWordCompletions
  cmd-.: editor::ToggleCodeActions
  cmd-\: pane::SplitRight
  cmd-u: editor::UndoSelection
  cmd-shift-u: editor::RedoSelection
  ctrl-j: editor::JoinLines
  ctrl-alt-backspace ctrl-alt-h: editor::DeleteToPreviousSubwordStart
  ctrl-alt-delete ctrl-alt-d: editor::DeleteToNextSubwordEnd
  ctrl-alt-left ctrl-alt-b: editor::MoveToPreviousSubwordStart
  ctrl-alt-right ctrl-alt-f: editor::MoveToNextSubwordEnd
  ctrl-alt-shift-left ctrl-alt-shift-b: editor::SelectToPreviousSubwordStart
  ctrl-alt-shift-right ctrl-alt-shift-f: editor::SelectToNextSubwordEnd
  cmd-k: {
    cmd-q q: editor::Rewrap
    cmd-d: editor::SelectNext(replace_newest)
    ctrl-cmd-d: editor::SelectPrevious(replace_newest)
    cmd-i: editor::Hover
    cmd-b: editor::BlameHover
    cmd-/: editor::ToggleBlockComments
    cmd-h: call_hierarchy::ShowIncomingCalls
    cmd-l: editor::ToggleFold
    cmd-[: editor::FoldRecursive
    cmd-]: editor::UnfoldRecursive
    cmd-1: editor::FoldAtLevel_1
    cmd-2: editor::FoldAtLevel_2
    cmd-3: editor::FoldAtLevel_3
    cmd-4: editor::FoldAtLevel_4
    cmd-5: editor::FoldAtLevel_5
    cmd-6: editor::FoldAtLevel_6
    cmd-7: editor::FoldAtLevel_7
    cmd-8: editor::FoldAtLevel_8
    cmd-9: editor::FoldAtLevel_9
    cmd-0: editor::FoldAll
    cmd-j: editor::UnfoldAll
    r: editor::RevealInFileManager
    p: editor::CopyPath
  }
  cmd-alt-g: {
    b: git::Blame
    m: git::OpenModifiedFiles
    r: git::ReviewDiff
  }

  mode == full {   // #3,#43
    shift-enter enter: editor::Newline
    cmd-enter: editor::NewlineBelow
    cmd-shift-enter: editor::NewlineAbove
    "cmd-k z": editor::ToggleSoftWrap
    cmd-f: buffer_search::Deploy
    cmd-alt-l: buffer_search::Deploy(selection_search_enabled)
    cmd-e: buffer_search::UseSelectionForFind
    cmd->: agent::AddSelectionToThread
    cmd-alt-e: editor::SelectEnclosingSymbol
    alt-enter: editor::OpenSelectionsInMultibuffer
    alt-cmd-f: text_finder::Toggle
    cmd-shift-o: outline::Toggle
    ctrl-g: go_to_line::Toggle
    cmd-shift-backspace: editor::GoToPreviousChange
    cmd-shift-alt-backspace: editor::GoToNextChange

    edit_prediction {   // #5
      alt-tab: editor::NextEditPrediction
      alt-shift-tab: editor::PreviousEditPrediction
    }
  }

  multibuffer {   // #4
    cmd-up: editor::MoveToStartOfExcerpt
    cmd-down: editor::MoveToStartOfNextExcerpt
    cmd-shift-up: editor::SelectToStartOfExcerpt
    cmd-shift-down: editor::SelectToStartOfNextExcerpt
  }

  !edit_prediction {   // #6
    alt-tab: editor::ShowEditPrediction
  }

  mode == auto_height {   // #7
    ctrl-enter shift-enter: editor::Newline
    ctrl-shift-enter: editor::NewlineBelow
  }

  jupyter {   // #9
    ctrl-shift-enter: repl::Run
    ctrl-alt-enter: repl::RunInPlace
  }

  !agent_diff & !AgentPanel {   // #10
    cmd-alt-z: git::Restore
    cmd-alt-y: git::ToggleStaged
    cmd-y: git::StageAndNext
    cmd-shift-y: git::UnstageAndNext
  }

  editor_agent_diff {   // #12
    cmd-y cmd-alt-y: agent::Keep
    cmd-alt-z: agent::Reject
    shift-alt-y: agent::KeepAll
    shift-alt-z: agent::RejectAll
    shift-ctrl-r: agent::OpenAgentDiff
  }

  extension == md {   // #40
    "cmd-k v": markdown::OpenPreviewToTheSide
    cmd-shift-v: markdown::OpenPreview
  }

  extension == svg {   // #41
    "cmd-k v": svg::OpenPreviewToTheSide
    cmd-shift-v: svg::OpenPreview
  }

  (extension == csv | extension == tsv | extension == ssv | extension == psv) {   // #42
    "cmd-k v": tabular_data::OpenPreviewToTheSide
    cmd-shift-v: tabular_data::OpenPreview
  }

  renaming {   // #54
    enter: editor::ConfirmRename
  }

  inline_input {   // #55
    enter: menu::Confirm
  }

  showing_completions {   // #56
    enter: editor::ConfirmCompletion
    shift-enter: editor::ConfirmCompletionReplace
    tab: editor::ComposeCompletion
  }

  in_snippet {

    has_next_tabstop & !showing_completions {   // #57
      tab: editor::NextSnippetTabstop
    }

    has_previous_tabstop & !showing_completions {   // #58
      shift-tab: editor::PreviousSnippetTabstop
    }
  }

  edit_prediction {   // #59
    alt-tab: editor::AcceptEditPrediction
    ctrl-cmd-right: editor::AcceptNextWordEditPrediction
    ctrl-cmd-down: editor::AcceptNextLineEditPrediction

    edit_prediction_mode == eager & !showing_completions {   // #60
      tab: editor::AcceptEditPrediction
    }
  }

  showing_code_actions {   // #61
    enter: editor::ConfirmCodeAction
  }

  (showing_code_actions | showing_completions) {   // #62
    up ctrl-p: editor::ContextMenuPrevious
    down ctrl-n: editor::ContextMenuNext
    pageup: editor::ContextMenuFirst
    pagedown: editor::ContextMenuLast
  }

  showing_signature_help & !showing_completions {   // #63
    up: editor::SignatureHelpPrevious
    down: editor::SignatureHelpNext
  }
}

