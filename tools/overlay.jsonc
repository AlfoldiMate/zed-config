// ~/.config/zed/keymap.json — Zed 1.21, Helix first, vim fallback, semantic across views.
//
// Zed loads default-macos.json, then vim.json (helix + vim), then this file. This file is an overlay:
// it only adds what Zed's Helix layer lacks and makes the same letters mean the same thing in
// buffers, panels and pickers. Learn it from KEYMAP.md. Design notes in KEYMAP-DESIGN.md.
//
// Rules kept here:
//   - a prefix key is never a leaf in the same context (bare `space` is null wherever it is a leader)
//   - one key per meaning per mode, no cmd/ctrl aliases of modal keys
//   - `g …` only moves, `space …` only runs, `space .` opens the context menu for the rare rest
[
  // ── Buffer: Helix normal and select ───────────────────────────────────────
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "space": null, // leader must not be a leaf (vim.json binds bare space to WrappingRight)
      "ctrl-s": "workspace::Save",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",

      // goto: additions to Helix's g set (g d, g r, g i, g a, g n, g p, g w, g ., g e, g h, g l, g s come from vim.json)
      "g y": "editor::GoToTypeDefinition",
      "g m": "editor::GoToHunk", // next modification (hunk); [ g and ] g also walk hunks
      "g shift-m": "editor::GoToPreviousHunk",
      "g o": "outline::Toggle", // symbol in file (replaces Zed's g o = expand hunks; that is ] g + space g h)
      "g shift-o": "project_symbols::Toggle",
      "g r n": null, // Zed binds g r n/r/i/a (LSP rename etc.); nulling them keeps g r instant
      "g r r": null,
      "g r i": null,
      "g r a": null,

      // space: Helix gives f b s S / w k r a d c y p h. These are the additions.
      "space .": "editor::OpenContextMenu",
      "space :": "command_palette::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space g": "git_panel::ToggleFocus",
      "space t": "terminal_panel::ToggleFocus",
      "space x": "diagnostics::Deploy",
      "space m": "markdown::OpenPreviewToTheSide",
      "space u w": "editor::ToggleSoftWrap",
      "space u z": "workspace::ToggleCenteredLayout",
      "space u i": "editor::ToggleInlayHints",
      "space u d": "editor::ToggleDiagnostics",
      "space u b": "git::Blame",
      "space q": "workspace::CloseWindow",
      "space shift-q": "zed::Quit"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-s": "workspace::Save"
    }
  },

  // ── Panels: navigation and leader shared by every list panel ─────────────
  {
    "context": "!Editor && !Terminal",
    "bindings": {
      "space": null,
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "space :": "command_palette::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space g": "git_panel::ToggleFocus",
      "space t": "terminal_panel::ToggleFocus",
      "space x": "diagnostics::Deploy",
      "space q": "workspace::CloseWindow"
    }
  },

  // ── Explorer: same letters as the buffer (a add, r rename, d delete, y yank, p paste, x cut, . menu)
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Trash",
      "shift-d": "project_panel::Delete",
      "y": "project_panel::Copy",
      "shift-y": "workspace::CopyRelativePath",
      "x": "project_panel::Cut",
      "p": "project_panel::Paste",
      "o": "project_panel::OpenSplitVertical",
      "shift-o": "project_panel::OpenSplitHorizontal",
      ".": "project_panel::OpenContextMenu",
      "g .": "pane::RevealInProjectPanel", // goto: the file that is open in the editor
      "shift-h": "project_panel::ToggleHideGitIgnore",
      "z c": "project_panel::CollapseAllEntries"
    }
  },

  // ── Outline panel ────────────────────────────────────────────────────────
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "z c": "outline_panel::CollapseAllEntries"
    }
  },

  // ── Git panel (vim.json gives j k h l gg G, x toggle staged, X stage all, U unstage all, i commit box)
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector",
    "bindings": {
      "space": null,
      "s": "git::ToggleStaged", // s for stage, x still works
      "shift-s": "git::StageAll",
      "u": "git::UnstageFile",
      "d": "git::RestoreFile", // discard the change (asks first)
      "c": "git::Commit",
      "shift-c": "git::Amend",
      "shift-i": "git::GenerateCommitMessage",
      "f": "git::Fetch",
      "p": "git::Pull",
      "shift-p": "git::Push",
      "b": "git::Branch",
      "y": "workspace::CopyRelativePath",
      "o": "git::OpenFileDiff", // open the diff for this file, enter opens it too
      "shift-o": "git::OpenModifiedFiles",
      ".": "git_panel::OpenMenu",
      "g h": "git_panel::ActivateHistoryTab",
      "g c": "git_panel::ActivateChangesTab",
      "shift-t": "git::StashAll",
      "z z": "git::Diff"
    }
  },
  {
    "context": "GitPanel && HistoryList && !GitBranchSelector && !GitRepositorySelector",
    "bindings": {
      "space": null,
      "g c": "git_panel::ActivateChangesTab",
      ".": "git_panel::OpenMenu"
    }
  },
  {
    "context": "GitPanel && CommitEditor > Editor",
    "bindings": {
      "ctrl-s": "git::Commit",
      "ctrl-j": "git_panel::FocusChanges"
    }
  },

  // ── Pickers: the input is an editor, so j/k need ctrl ────────────────────
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
      "ctrl-l": "picker::TogglePreview",
      "ctrl-v": "menu::SecondaryConfirm" // open in split where the picker supports it
    }
  },

  // ── Terminal: only the way out and the pane moves ────────────────────────
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-/": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-/": "terminal_panel::ToggleFocus"
    }
  }
]
